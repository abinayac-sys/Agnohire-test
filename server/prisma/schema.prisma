generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime app connection: restricted, non-superuser, NOBYPASSRLS role so
  // Row-Level Security is actually enforced (RLS Phase 1).
  url       = env("DATABASE_URL")
  // Migrations / introspection run as the owner so DDL (and CREATE ROLE) works.
  directUrl = env("DIRECT_URL")
}

model User {
  id                        String              @id @default(uuid())
  fullName                  String
  // Unique among LIVE users only (still global across tenants — this is not
  // per-tenant identity). Enforced by a PARTIAL unique index:
  //   CREATE UNIQUE INDEX "User_email_active_key"
  //     ON "User"(email) WHERE "deletedAt" IS NULL;
  // defined in migration 20260714110000_user_email_live_unique. Prisma cannot
  // express a partial constraint, so it is intentionally NOT @unique here — keep
  // this comment in sync with the migration.
  //
  // Two consequences for anyone touching this column:
  //  1. `email` is NOT in UserWhereUniqueInput. Use findFirst, never findUnique.
  //  2. Soft-deleted rows may now duplicate an email (and coexist with a live
  //     one), so any tombstone lookup must orderBy { deletedAt: 'desc' } and take
  //     the newest, or it will resurrect an arbitrary one.
  email                     String
  passwordHash              String?
  avatarUrl                 String?
  phone                     String?
  roleId                    String
  sectorId                  String?
  isActive                  Boolean             @default(true)
  // Forces the password-change modal on next login — set true whenever an
  // operator sets/resets this user's password on their behalf (they never
  // chose it themselves), cleared the moment they successfully change it.
  mustChangePassword        Boolean             @default(false)
  lastLoginAt               DateTime?
  loginAttempts             Int                 @default(0)
  lockedUntil               DateTime?
  resetToken                String?
  resetTokenExp             DateTime?
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
  deletedAt                 DateTime?
  address                   String?
  bio                       String?
  dateOfBirth               DateTime?
  department                String?
  gender                    String?
  jobTitle                  String?
  location                  String?
  auditLogs                 AuditLog[]
  feedbacks                 InterviewFeedback[]
  approvedJobs              JobRequisition[]    @relation("JobApprover")
  createdJobs               JobRequisition[]    @relation("JobCreator")
  notifications             Notification[]      @relation("NotificationRecipient")
  adminNotificationStates   AdminNotificationState[] @relation("AdminNotificationStates")
  oauthAccounts             OAuthAccount[]
  panelAssignments          PanelMember[]
  refreshTokens             RefreshToken[]
  role                      Role                @relation(fields: [roleId], references: [id])
  sector                    Sector?             @relation(fields: [sectorId], references: [id])
  sessions                  UserSession[]
  tenantId                  String?
  emailVerifiedAt           DateTime?
  verifyToken               String?
  tenant                    Tenant?             @relation(fields: [tenantId], references: [id])
  maintenanceWindowsCreated MaintenanceWindow[] @relation("MaintenanceWindowCreator")
  AiChatHistory             AiChatHistory[]
  organizationMemberships   OrganizationMember[]
  workspaceMemberships      WorkspaceMember[]
  communicationMessages     CommunicationMessage[]
  candidateTimelineEvents   CandidateTimelineEvent[]
  // Denormalized from this row's Sector — this row's "home" org/workspace, NOT
  // the authorization boundary. Which workspaces a user may actually ACT in is
  // governed entirely by their OrganizationMember/WorkspaceMember rows above;
  // an admin with sectorId (and so these) null still has real memberships.
  organizationId            String?
  workspaceId               String?

  @@index([roleId])
  @@index([sectorId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

model Role {
  id              String                 @id @default(uuid())
  name            String                 @unique
  displayName     String
  permissions     RolePermission[]
  users           User[]
  // Per-tenant permission overrides. A tenant that customizes this role's
  // permissions gets its own row here; the global `permissions` above are the
  // default applied to tenants that never customized it.
  tenantOverrides TenantRolePermission[]
}

// Per-tenant override of a role's permission set. Presence of a row means the
// tenant has customized this role: its `permissionKeys` (which may be empty)
// fully replace the global Role.permissions defaults FOR THAT TENANT ONLY, so
// one tenant's role edits never leak into another's.
model TenantRolePermission {
  tenantId       String
  roleId         String
  permissionKeys String[]
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  role           Role     @relation(fields: [roleId], references: [id])

  @@id([tenantId, roleId])
  @@index([tenantId])
}

// Platform-wide scheduled maintenance windows. No tenantId — applies to the
// whole app, not one tenant. Created by SUPERADMIN only.
model MaintenanceWindow {
  id          String   @id @default(uuid())
  title       String
  message     String
  startAt     DateTime
  endAt       DateTime
  status      String   @default("SCHEDULED") // SCHEDULED|NOTIFIED|ACTIVE|COMPLETED|CANCELLED
  createdById String
  createdBy   User     @relation("MaintenanceWindowCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startAt])
}

model Permission {
  id    String           @id @default(uuid())
  key   String           @unique
  label String
  group String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@id([roleId, permissionId])
}

model OAuthAccount {
  id                String   @id @default(uuid())
  userId            String
  provider          String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  ipAddress  String
  userAgent  String
  deviceInfo Json?
  loginAt    DateTime  @default(now())
  logoutAt   DateTime?
  isActive   Boolean   @default(true)
  user       User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  token        String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Why this session is allowed to skip the tenant-approval gate: it was
  /// minted by operator impersonation (platform.controller.tenantLogin).
  /// refresh() re-runs the gate for normal sessions (false) so a tenant that
  /// is later un-approved or suspended actually loses access, and keeps
  /// exempting impersonated ones (true) so an operator can stay inside a
  /// tenant they are reviewing. Rotation inherits the flag.
  impersonated Boolean   @default(false)
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Sector {
  id              String                @id @default(uuid())
  // Unique per tenant, case-insensitively — matches resolveSectorId()'s own
  // case-insensitive name lookup. Enforced by a partial unique index
  // (tenantId, lower(name)) WHERE deletedAt IS NULL — defined in migration
  // 20260813182523_sector_domain_questionbank_name_unique_per_tenant (Prisma
  // schema cannot express a partial/expression index, so it is intentionally
  // not declared here).
  name            String
  type            String
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  deletedAt       DateTime?
  candidates      Candidate[]
  domains         Domain[]
  integrations    Integration[]
  jobRequisitions JobRequisition[]
  configurations  SystemConfiguration[]
  users           User[]
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id])
  // Anchor of the Organization/Workspace retrofit (see Organization/Workspace
  // models below): nullable during the staged rollout, backfilled to every
  // tenant's default Organization/Workspace, then tightened to NOT NULL once
  // backfill is verified complete. Every dependent below that already reaches
  // this Sector via sectorId (Domain, JobRequisition, Candidate, Integration,
  // SystemConfiguration, ...) gets its own denormalized organizationId/
  // workspaceId backfilled FROM this column, mirroring how those same tables
  // already denormalize tenantId alongside sectorId.
  organizationId  String
  workspaceId     String
  organization    Organization          @relation(fields: [organizationId], references: [id])
  workspace       Workspace             @relation(fields: [workspaceId], references: [id])

  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

// A Tenant may run multiple Organizations (e.g. distinct business units sharing
// one billing/tenant account). Every existing tenant gets exactly one, created
// automatically by the backfill migration — see migration
// 20260812110000_organization_workspace_core_tables and the one that follows
// it. Not itself a security boundary on business data; Workspace (below) is.
model Organization {
  id         String             @id @default(uuid())
  tenantId   String
  name       String
  slug       String?
  isActive   Boolean            @default(true)
  settings   Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  deletedAt  DateTime?
  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  workspaces Workspace[]
  members    OrganizationMember[]
  sectors    Sector[]

  // Slug is unique PER TENANT among LIVE rows only. Enforced by a PARTIAL
  // unique index (tenantId, slug) WHERE deletedAt IS NULL — Prisma cannot
  // express a partial constraint, so it is intentionally NOT declared as
  // @@unique here (mirrors Candidate.email's identical convention; keep this
  // comment in sync with migration
  // 20260812160000_organization_workspace_slug_soft_delete_scoped).
  @@index([tenantId])
}

// An Organization may run multiple Workspaces. This is the real, enforced data
// isolation boundary below Tenant — see Sector.workspaceId above and the
// workspace_isolation RLS policies added once the AsyncLocalStorage scope
// context and its GUCs are live (server/src/config/tenantContext.ts,
// server/src/config/database.ts).
model Workspace {
  id             String            @id @default(uuid())
  // Denormalized ancestor id — same convention JobRequisition already uses for
  // tenantId even though it's derivable via Sector.
  tenantId       String
  organizationId String
  name           String
  slug           String?
  isActive       Boolean           @default(true)
  settings       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  members        WorkspaceMember[]
  sectors        Sector[]

  // Same partial-unique-index convention as Organization.slug above — see
  // migration 20260812160000_organization_workspace_slug_soft_delete_scoped.
  @@index([tenantId])
  @@index([organizationId])
}

// Container-level role for Organization membership (ORG_ADMIN | ORG_MEMBER) —
// distinct from the ATS functional Role (HR/RECRUITER/etc.) on User, which is
// unaffected by this table. TENANT_OWNER/ADMIN/SUPERADMIN never need a row
// here to administer every org in their tenant; see
// workspaceMembershipService.canAccessWorkspace.
model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  // Denormalized, mirrors the tenant choke-point pattern used everywhere else.
  tenantId       String
  userId         String
  role           String       @default("ORG_MEMBER")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([tenantId])
}

// Container-level role for Workspace membership (WORKSPACE_ADMIN |
// WORKSPACE_MEMBER) — see OrganizationMember above for the same rationale.
model WorkspaceMember {
  id             String    @id @default(uuid())
  workspaceId    String
  tenantId       String
  userId         String
  role           String    @default("WORKSPACE_MEMBER")
  // Grantable capability, OFF by default: lets this specific member manage
  // users scoped to this one workspace even if their ATS role otherwise
  // lacks `user.manage`. Only settable by a caller who already holds
  // `workspace.manage` (tenant/org admin) — see workspaceService.ts. Kept
  // independent of `role` (WORKSPACE_ADMIN/WORKSPACE_MEMBER): the container
  // role is a display/ownership label, this is an explicit, auditable grant.
  canManageUsers Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  user           User      @relation(fields: [userId], references: [id])

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([tenantId])
}

model Domain {
  id              String           @id @default(uuid())
  // Unique per (tenant, sector), case-insensitively — matches
  // resolveDomainId()'s own case-insensitive lookup. Enforced by a partial
  // unique index (tenantId, sectorId, lower(name)) WHERE deletedAt IS NULL —
  // defined in migration
  // 20260813182523_sector_domain_questionbank_name_unique_per_tenant (Prisma
  // schema cannot express a partial/expression index, so it is intentionally
  // not declared here). Domains with no sector are not deduplicated against
  // each other (NULL is never equal to NULL).
  name            String
  parentId        String?
  sectorId        String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  deletedAt       DateTime?
  candidates      Candidate[]
  parent          Domain?          @relation("DomainTree", fields: [parentId], references: [id])
  children        Domain[]         @relation("DomainTree")
  sector          Sector?          @relation(fields: [sectorId], references: [id])
  jobRequisitions JobRequisition[]
  questions       Question[]
  questionBanks   QuestionBank[]
  recruiterSkills RecruiterSkill[]
  tenantId        String
  // Denormalized from this row's Sector, nullable forever (sectorId itself is
  // optional here) — see Sector.organizationId/workspaceId's doc comment.
  organizationId  String?
  workspaceId     String?

  @@index([sectorId])
  @@index([parentId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

model RecruiterSkill {
  id        String   @id @default(uuid())
  userId    String
  domainId  String
  skillTags String[]
  domain    Domain   @relation(fields: [domainId], references: [id])

  @@index([userId])
  @@index([domainId])
}

model JobRequisition {
  id                String                   @id @default(uuid())
  title             String
  description       String
  sectorId          String
  domainId          String
  createdById       String
  approvedById      String?
  templateId        String?
  status            String                   @default("DRAFT")
  workMode          String?
  location          String?
  experienceMin     Int?
  experienceMax     Int?
  budgetMin         Decimal?
  budgetMax         Decimal?
  headcount         Int                      @default(1)
  filled            Int                      @default(0)
  skills            String[]
  deadline          DateTime?
  approvedAt        DateTime?
  closedAt          DateTime?
  aiGeneratedJd     Boolean                  @default(false)
  // Public careers page: per-job opt-in to show this job's budget range on the
  // public listing/detail (default off — compensation is sensitive, and this
  // is set per job rather than tenant-wide so admins choose case by case).
  showSalaryPublicly Boolean                 @default(false)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  deletedAt         DateTime?
  approvalWorkflows ApprovalWorkflow[]
  candidates        Candidate[]
  interviews        Interview[]
  workflowRounds    InterviewWorkflowRound[]
  applications      JobApplication[]
  approvedBy        User?                    @relation("JobApprover", fields: [approvedById], references: [id])
  createdBy         User                     @relation("JobCreator", fields: [createdById], references: [id])
  domain            Domain                   @relation(fields: [domainId], references: [id])
  sector            Sector                   @relation(fields: [sectorId], references: [id])

  tenantId String
  // Denormalized from this row's Sector — tightened to NOT NULL alongside
  // Sector.organizationId/workspaceId, since sectorId is required here.
  organizationId String
  workspaceId    String

  @@index([sectorId])
  @@index([domainId])
  @@index([status])
  @@index([createdById])
  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

model JobTemplate {
  id             String    @id @default(uuid())
  name           String
  domainId       String?
  description    String?
  skills         String[]
  experienceMin  Int?
  experienceMax  Int?
  workMode       String?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  sectorId       String?
  workflowRounds Json?
  headcount      Int?
  location       String?
  tenantId       String
  organizationId String?
  workspaceId    String?

  @@index([sectorId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

model ApprovalWorkflow {
  id               String         @id @default(uuid())
  jobRequisitionId String
  approverId       String
  status           String         @default("PENDING")
  comments         String?
  actionedAt       DateTime?
  createdAt        DateTime       @default(now())
  job              JobRequisition @relation(fields: [jobRequisitionId], references: [id])

  @@index([jobRequisitionId])
}

model InterviewWorkflowRound {
  id               String         @id @default(uuid())
  jobRequisitionId String
  roundNumber      Int
  roundName        String
  roundType        String
  passPercentage   Float?
  sequenceOrder    Int
  isMandatory      Boolean        @default(true)
  autoProgression  Boolean        @default(true)
  job              JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)

  @@index([jobRequisitionId])
}

model Candidate {
  id                String                @id @default(uuid())
  userId            String?               @unique
  sectorId          String?
  domainId          String?
  fullName          String
  // Email is unique PER TENANT, not globally: two customers may legitimately
  // hold the same candidate. Enforced by a partial unique index
  // (tenantId, email) WHERE deletedAt IS NULL — defined in migration
  // 20260708120000_candidate_email_tenant_scoped (Prisma schema cannot express
  // a partial unique constraint, so it is intentionally not declared here).
  email             String
  phone             String?
  experienceLevel   String?
  skills            String[]
  linkedinUrl       String?
  githubUrl         String?
  location          String?
  currentRole       String?
  avatarUrl         String?
  source            String?
  fitScore          Float?
  consentGiven      Boolean               @default(false)
  consentAt         DateTime?
  gdprDeletedAt     DateTime?
  offerAccepted     Boolean               @default(false)
  offerAcceptedDate DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  deletedAt         DateTime?
  jobRequisitionId  String?
  domain            Domain?               @relation(fields: [domainId], references: [id])
  jobRequisition    JobRequisition?       @relation(fields: [jobRequisitionId], references: [id])
  sector            Sector?               @relation(fields: [sectorId], references: [id])
  assignments       CandidateAssignment[]
  listItems         CandidateListItem[]
  interviews        Interview[]
  applications      JobApplication[]
  resumes           Resume[]

  tenantId String?
  organizationId String?
  workspaceId    String?
  timelineEvents CandidateTimelineEvent[]

  @@index([sectorId])
  @@index([domainId])
  @@index([jobRequisitionId])
  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

model JobApplication {
  id               String         @id @default(uuid())
  candidateId      String
  jobRequisitionId String
  status           String         @default("APPLIED")
  stage            String?
  fitScore         Float?
  fitScoreData     Json?
  appliedAt        DateTime       @default(now())
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  deletedAt        DateTime?
  completedRounds  Json?
  currentRound     Int            @default(1)
  failedRound      Int?
  workflowStatus   String         @default("IN_PROGRESS")
  rejectionReason  String?
  rejectedRound    String?
  candidate        Candidate      @relation(fields: [candidateId], references: [id])
  job              JobRequisition @relation(fields: [jobRequisitionId], references: [id])
  offers           Offer[]
  pipelineNotes    PipelineNote[]

  tenantId String?

  @@index([candidateId])
  @@index([jobRequisitionId])
  @@index([status])
  @@index([tenantId])
}

model CandidateList {
  id           String                @id @default(uuid())
  name         String
  uploadedById String
  sectorId     String?
  assignedTo   String?
  totalCount   Int                   @default(0)
  validCount   Int                   @default(0)
  errorCount   Int                   @default(0)
  // Rows that resolved to an ALREADY-EXISTING candidate (matched by email,
  // phone, resume, LinkedIn or GitHub) rather than creating a new one — e.g.
  // the same person appears in two different source files. These count
  // toward validCount (they were added to this list successfully) but are
  // surfaced separately so re-uploading overlapping data doesn't look like
  // stale/wrong results.
  linkedCount  Int                   @default(0)
  status       String                @default("PROCESSING")
  // BULK_IMPORT (created by the candidate-import drawer, from a CSV/Excel
  // file) vs CURATED (built up manually from Sourcing/Talent Search as a
  // reusable data directory). Deleting a list behaves differently per kind —
  // see deleteCandidateList — so this must be set explicitly at creation, not
  // inferred later. Defaults to CURATED (the non-destructive delete path) so
  // any row that predates this column is never accidentally treated as
  // disposable.
  source       String                @default("CURATED")
  errorReport  Json?
  linkedReport Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?
  assignments  CandidateAssignment[]
  items        CandidateListItem[]
  tenantId     String
  organizationId String?
  workspaceId    String?

  @@index([tenantId])
  @@index([organizationId])
  @@index([workspaceId])
}

model CandidateListItem {
  id              String        @id @default(uuid())
  candidateListId String
  candidateId     String
  candidate       Candidate     @relation(fields: [candidateId], references: [id])
  list            CandidateList @relation(fields: [candidateListId], references: [id])

  @@unique([candidateListId, candidateId])
}

model CandidateAssignment {
  id           String         @id @default(uuid())
  candidateId  String
  recruiterId  String
  listId       String?
  assignedById String
  status       String         @default("ASSIGNED")
  assignedAt   DateTime       @default(now())
  candidate    Candidate      @relation(fields: [candidateId], references: [id])
  list         CandidateList? @relation(fields: [listId], references: [id])
  tenantId     String?

  @@index([candidateId])
  @@index([recruiterId])
  @@index([tenantId])
}

model Resume {
  id          String    @id @default(uuid())
  candidateId String
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  isPrimary   Boolean   @default(true)
  parsedData  Json?
  parsedAt    DateTime?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?
  fileData    Bytes?
  parseError  String?
  parseStatus String    @default("PENDING")
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  tenantId    String?

  @@index([candidateId])
  @@index([tenantId])
}

model Interview {
  id               String              @id @default(uuid())
  candidateId      String
  recruiterId      String
  questionBankId   String?
  scheduleId       String?             @unique
  status           String              @default("SCHEDULED")
  type             String              @default("AI")
  accessToken      String?             @unique
  startedAt        DateTime?
  completedAt      DateTime?
  duration         Int?
  violations       Json?
  recordingUrl     String?
  transcriptUrl    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  transcript       String?
  terminatedReason String?
  jobRequisitionId String?
  roundNumber      Int?
  answers          CandidateAnswer[]
  candidate        Candidate           @relation(fields: [candidateId], references: [id])
  jobRequisition   JobRequisition?     @relation(fields: [jobRequisitionId], references: [id])
  schedule         InterviewSchedule?  @relation(fields: [scheduleId], references: [id])
  feedbacks        InterviewFeedback[]
  questions        InterviewQuestion[]
  result           InterviewResult?
  panelMembers     PanelMember[]
  proctorShots     ProctorShot[]
  biometricReport  BiometricReport?

  tenantId String?
  communicationMeeting CommunicationMeeting?

  @@index([candidateId])
  @@index([recruiterId])
  @@index([status])
  @@index([jobRequisitionId])
  @@index([tenantId])
}

/// Webcam proctoring snapshots captured during a live interview. Bytes live in
/// Postgres (same pattern as Resume.fileData) so evidence travels with the DB.
model ProctorShot {
  id          String    @id @default(uuid())
  interviewId String
  reason      String    @default("PERIODIC")
  note        String?
  mimeType    String    @default("image/jpeg")
  imageData   Bytes
  capturedAt  DateTime  @default(now())
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)

  @@index([interviewId])
}

model InterviewSchedule {
  id              String     @id @default(uuid())
  candidateId     String
  recruiterId     String
  scheduledDate   DateTime
  duration        Int
  timezone        String     @default("UTC")
  instructions    String?
  meetingLink     String?
  calendarEventId String?
  reminderSent    Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
