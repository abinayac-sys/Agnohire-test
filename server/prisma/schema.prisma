// ─────────────────────────────────────────────────────────────────────────────
// Multi-tenant SaaS: tenancy, plans, subscriptions, usage metering, billing.
// Additive — introduced for the cloud SaaS migration. Tenant is the top-level
// isolation boundary; existing Sector becomes a unit WITHIN a tenant.
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                 String                 @id @default(uuid())
  name               String
  slug               String                 @unique
  status             String                 @default("PENDING") // PENDING|ACTIVE|SUSPENDED|CANCELLED
  ownerUserId        String?
  // Platform operator who provisioned this tenant (null = self-registered).
  // Drives the Tenant Accounts split and gates edit/impersonation to the
  // operator who created it.
  createdById        String?
  planId             String?
  settings           Json?
  razorpayCustomerId String?
  // Owner contact number collected at signup — the number marketing calls to
  // qualify a self-serve tenant before approving it.
  phone              String?
  // Sales/marketing approval, orthogonal to billing `status`. Self-serve signups
  // start PENDING (inert, cannot log in); admin-provisioned + legacy tenants are
  // APPROVED. A tenant is only usable once APPROVED.
  approvalStatus     String                 @default("APPROVED") // PENDING|APPROVED|REJECTED
  approvedAt         DateTime?
  approvedById       String?
  approvalNotes      String?
  // IANA timezone (e.g. "Asia/Kolkata"), auto-detected from the owner's
  // browser at signup and editable later. Consumed by server-rendered
  // artifacts (PDF reports, transactional emails) that have no browser to
  // implicitly localize into — everything else already renders in the
  // viewer's own local time via the browser.
  timezone           String                 @default("UTC")
  // Platform-superadmin-only feature grant for the public careers page
  // (website embed). Defaults OFF for every tenant — hidden from the tenant's
  // own admin UI until a superadmin grants it here. NOT editable by tenant
  // staff; contrast with CONFIG_KEYS.CAREERS_ENABLED, which is the tenant's
  // own on/off switch for an already-granted page.
  careersPageEnabled Boolean                @default(false)
  // Per-tenant add-on capacity purchased on top of the plan's included
  // maxX — independent of the shared Plan row, so buying add-ons for this
  // tenant never affects any other tenant on the same plan. Only meaningful
  // when the plan has a matching pricePerX configured (see
  // billingService.purchaseAddonCapacity); always 0 otherwise.
  extraOrganizations Int                    @default(0)
  extraWorkspaces    Int                    @default(0)
  extraUsers         Int                    @default(0)
  extraCandidates    Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?
  plan               Plan?                  @relation(fields: [planId], references: [id])
  subscription       Subscription?
  users              User[]
  sectors            Sector[]
  organizations      Organization[]
  workspaces         Workspace[]
  usageCounters      UsageCounter[]
  invites            TenantInvite[]
  invoices           Invoice[]
  roleOverrides      TenantRolePermission[]
  AiChatHistory      AiChatHistory[]
  addonPurchases     TenantAddonPurchase[]
  pendingAddonChanges TenantAddonPendingChange[]
  recurringAddonCharges RecurringAddonCharge[]

  @@index([status])
  @@index([approvalStatus])
}

model Plan {
  id                       String         @id @default(uuid())
  code                     String         @unique // FREE|STARTER|PRO|ENTERPRISE|LEGACY_ENTERPRISE
  name                     String
  priceMonthly             Decimal?
  priceYearly              Decimal?
  currency                 String         @default("INR")
  isActive                 Boolean        @default(true)
  razorpayPlanIdMonthly    String?
  razorpayPlanIdYearly     String?
  // Limits: NULL = unlimited
  maxUsers                 Int?
  maxInterviewedCandidates Int?
  maxActiveJobs            Int?
  maxCandidates            Int?
  maxSchedules             Int?
  maxOrganizations         Int?
  maxWorkspaces            Int?
  storageMb                Int?
  // Per-unit price for self-service add-on capacity, in `currency`: NULL =
  // this metric has no add-on option, so maxX above is an unconditional hard
  // block. When set, a tenant can proactively buy add-on capacity at this
  // rate to raise their included quota — creation is ALWAYS blocked at the
  // effective (plan + add-on) limit either way; there is no automatic
  // metered-overage bypass — see entitlementService's assertWithinLimit.
  pricePerOrganization     Decimal?
  pricePerWorkspace        Decimal?
  pricePerUser             Decimal?
  pricePerCandidate        Decimal?
  // Deletion floor, independent of maxX above: NULL = no floor beyond the
  // existing structural one (a tenant's single "default" organization/
  // workspace can never be deleted). When set, a delete that would take the
  // tenant's LIVE count below this number is blocked — see
  // entitlementService's assertAboveMinimum.
  minOrganizations         Int?
  minWorkspaces            Int?
  minUsers                 Int?
  minCandidates            Int?
  // Free-trial length (days) granted on tenant approval — NULL falls back to
  // the platform-wide "billing.default_trial_days" SystemConfiguration
  // default. See tenantAdminService.approveTenant.
  trialDays                Int?
  aiEnabled                Boolean        @default(true)
  proctoringEnabled        Boolean        @default(true)
  featuresJson             Json?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  tenants                  Tenant[]
  subscriptions            Subscription[]
}

model Subscription {
  id                     String    @id @default(uuid())
  tenantId               String    @unique
  planId                 String
  status                 String    @default("CREATED") // CREATED|PENDING|TRIALING|ACTIVE|PAST_DUE|HALTED|CANCELLED|EXPIRED
  billingInterval        String    @default("monthly") // monthly|yearly
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  provider               String    @default("razorpay")
  razorpaySubscriptionId String?   @unique
  razorpayCustomerId     String?
  shortUrl               String?
  // Explicit opt-in for auto-collecting the recurring add-on/overage amount
  // via Razorpay each cycle (see billingService.attachRecurringAddonCharge).
  // Defaults OFF — a tenant admin must actively enable it; autoPayConsentedAt
  // is a permanent audit record of when they last did so (never cleared on
  // disable, so "when did they consent" stays answerable).
  autoPayEnabled         Boolean   @default(false)
  autoPayConsentedAt     DateTime?
  // Dedup timestamps for the two one-time TRIAL-expiry emails (see
  // jobs/subscriptionSweeper.ts + billing/billingEmailService.ts) — each
  // fires at most once per period, independent of the recurring add-on
  // renewal reminder (billingService.scheduleRenewalReminder), which is
  // about the amount to be charged, not the subscription itself lapsing.
  expiryReminderSentAt      DateTime?
  expiredNotificationSentAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  plan                   Plan      @relation(fields: [planId], references: [id])

  @@index([status])
}

// A tenant-requested reduction in purchased add-on capacity (see
// Tenant.extraX), deferred to take effect at the NEXT renewal — never
// applied immediately, since the tenant already paid for the current
// cycle's higher capacity (no proration, no early takeback; see
// entitlementService.applyPendingAddonChanges, called from rolloverPeriod).
model TenantAddonPendingChange {
  id        String    @id @default(uuid())
  tenantId  String
  metric    String // ORGANIZATIONS | WORKSPACES | USERS | CANDIDATES
  delta     Int // negative — a decrease request
  status    String    @default("PENDING") // PENDING | APPLIED | CANCELLED
  createdAt DateTime  @default(now())
  appliedAt DateTime?
  tenant    Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// One cycle's recurring add-on/overage amount actually attached to the
// tenant's Razorpay subscription as an addon (see
// billingService.attachRecurringAddonCharge) — only ever created when the
// tenant has autoPayEnabled. The unique constraint is the idempotency guard
// against attaching the same cycle's charge twice (retry, duplicate dispatch).
model RecurringAddonCharge {
  id              String    @id @default(uuid())
  tenantId        String
  periodEnd       DateTime
  amount          Decimal
  currency        String    @default("INR")
  razorpayAddonId String?
  status          String    @default("ATTACHED") // ATTACHED | FAILED
  errorMessage    String?
  createdAt       DateTime  @default(now())
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, periodEnd])
  @@index([tenantId])
}

model UsageCounter {
  id          String   @id @default(uuid())
  tenantId    String
  metric      String // USERS|INTERVIEWED_CANDIDATES|ACTIVE_JOBS|ASSESSMENTS
  periodStart DateTime
  value       Int      @default(0)
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId])
}

model PaymentEvent {
  id             String    @id @default(uuid())
  tenantId       String?
  provider       String    @default("razorpay")
  eventId        String    @unique
  eventType      String
  payloadJson    Json?
  signatureValid Boolean   @default(false)
  processedAt    DateTime?
  status         String    @default("RECEIVED") // RECEIVED|PROCESSED|SKIPPED|FAILED
  createdAt      DateTime  @default(now())

  @@index([tenantId])
  @@index([eventType])
}

model Invoice {
  id                String    @id @default(uuid())
  tenantId          String
  razorpayInvoiceId String?   @unique
  razorpayPaymentId String?
  amount            Decimal?
  currency          String    @default("INR")
  status            String    @default("PAID")
  periodStart       DateTime?
  periodEnd         DateTime?
  paidAt            DateTime?
  hostedUrl         String?
  createdAt         DateTime  @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

// A tenant-initiated, one-time purchase of add-on capacity (see
// Tenant.extraX / billingService.purchaseAddonCapacity) — distinct from
// Invoice, which mirrors only what Razorpay has actually collected for a
// subscription renewal. This is NOT yet wired into a real Razorpay charge
// (same fast-follow noted on the overage-billing feature); it's an internal
// record of a capacity increase and its price, shown on the Billing page.
model TenantAddonPurchase {
  id        String   @id @default(uuid())
  tenantId  String
  metric    String // ORGANIZATIONS | WORKSPACES | USERS | CANDIDATES
  quantity  Int
  unitPrice Decimal
  amount    Decimal
  currency  String   @default("INR")
  createdAt DateTime @default(now())
  // Immediate prorated charge for a mid-cycle increase — only issued when the
  // tenant has auto-pay enabled (see billingService.issueProratedInvoice).
  // Null on every field below means no proration was issued for this
  // purchase (no auto-pay, or the increase landed with ~0 cycle time left);
  // the increase still applies immediately either way, billed in full at the
  // next renewal via the existing recurring add-on charge.
  prorationAmount       Decimal?
  razorpayPaymentLinkId String?
  paymentLinkShortUrl   String?
  paymentLinkStatus     String? // PENDING | PAID | EXPIRED | CANCELLED
  tenant                Tenant  @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([razorpayPaymentLinkId])
}

model TenantInvite {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  roleId    String
  token     String   @unique
  status    String   @default("PENDING") // PENDING|ACCEPTED|EXPIRED|REVOKED
  expiresAt DateTime
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([email])
}

// ─── AI OPERATING SYSTEM OBSERVABILITY ───────────────────────────────────────

model AiPromptTemplate {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. "copilot_system_prompt"
  description String?
  content     String   @db.Text
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// AiToolUsage/AiTokenLog (dead schema — never written to anywhere in
// server/src) were dropped and replaced by AiUsageLog in migration
// 20260814_communication_module, alongside this module's own tables.
model AiUsageLog {
  id               String   @id @default(uuid())
  tenantId         String?
  userId           String?
  sessionId        String?
  feature          String
  agentName        String?
  toolName         String?
  provider         String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  costUsd          Decimal?
  billable         Boolean  @default(false)
  success          Boolean  @default(true)
  errorMsg         String?
  durationMs       Int?
  createdAt        DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([feature, createdAt])
  @@index([sessionId])
}

model AiChatHistory {
  id        String    @id @default(uuid())
  title     String
  messages  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenantId String?
  userId   String?
  // Best-effort only (G3) — see Notification's doc comment above.
  organizationId String?
  workspaceId    String?

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
}

model AdminNotificationState {
  id             String       @id @default(uuid())
  adminId        String
  notificationId String
  isRead         Boolean      @default(false)
  isCleared      Boolean      @default(false)
  tenantId       String?
  // Best-effort only (G3) — see Notification's doc comment above.
  organizationId String?
  workspaceId    String?
  admin          User         @relation("AdminNotificationStates", fields: [adminId], references: [id], onDelete: Cascade)
  notification   Notification @relation("NotificationAdminStates", fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([adminId, notificationId])
  @@index([adminId])
  @@index([notificationId])
  @@index([tenantId])
}

// ─── TEAM COMMUNICATION / CALLING / AI-SUMMARIZATION MODULE (STANDALONE) ─────
//
// Entirely new, tenantId-scoped module — one "hub" per tenant (formerly
// modeled in the source repo as `CommunicationWorkspace`, renamed here to
// `CommunicationHub` / `commHubId` to avoid colliding in meaning with the
// Organization/Workspace hierarchy above; this module does NOT interact with
// Organization/Workspace at all). See migration
// 20260814000000_communication_module for the recreate-from-scratch history
// this end state replicates (the source repo's prototype → drop → rebuild).

enum CommunicationChannelType {
  GENERAL
  ANNOUNCEMENT
  DEPARTMENT
  TEAM
  PROJECT
  DIRECT
  JOB_DISCUSSION
  INTERVIEW_ROOM
  CANDIDATE_PORTAL
}

enum CommunicationChannelRole {
  OWNER
  ADMIN
  MEMBER
}

enum CommunicationMessageType {
  TEXT
  EMOJI
  GIF
  IMAGE
  VIDEO
  FILE
  AUDIO
  VOICE_NOTE
}

enum CommunicationCallType {
  AUDIO
  VIDEO
  SCREEN
}

enum CommunicationCallStatus {
  INITIATED
  ONGOING
  ENDED
  MISSED
  REJECTED
}

enum CommunicationPresenceStatus {
  ONLINE
  AWAY
  BUSY
  INVISIBLE
  OFFLINE
}

model CommunicationHub {
  id          String   @id @default(uuid())
  tenantId    String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels  CommunicationChannel[]
  meetings  CommunicationMeeting[]

  @@index([tenantId])
}

model CommunicationChannel {
  id          String                   @id @default(uuid())
  tenantId    String
  commHubId   String
  name        String
  type        CommunicationChannelType @default(GENERAL)
  isPrivate   Boolean                  @default(false)
  isArchived  Boolean                  @default(false)
  description String?
  entityType  String?
  entityId    String?
  createdById String
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  deletedAt   DateTime?

  commHub     CommunicationHub             @relation(fields: [commHubId], references: [id], onDelete: Cascade)
  members     CommunicationChannelMember[]
  messages    CommunicationMessage[]
  calls       CommunicationCall[]
  aiSummaries CommunicationAiSummary[]
  notes       CommunicationNote[]

  @@index([tenantId])
  @@index([commHubId])
  @@index([createdById])
}

model CommunicationChannelMember {
  id         String                   @id @default(uuid())
  tenantId   String
  channelId  String
  userId     String
  role       CommunicationChannelRole @default(MEMBER)
  isFavorite Boolean                  @default(false)
  isArchived Boolean                  @default(false)
  joinedAt   DateTime                 @default(now())
  lastReadAt DateTime                 @default(now())

  channel CommunicationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([tenantId])
  @@index([channelId])
  @@index([userId])
}

model CommunicationMessage {
  id        String                   @id @default(uuid())
  tenantId  String
  channelId String?
  dmPairId  String?
  senderId  String
  sender    User                     @relation(fields: [senderId], references: [id])
  content   String?
  type      CommunicationMessageType @default(TEXT)
  mediaUrl  String?
  fileName  String?
  fileSize  Int?
  replyToId String?
  isPinned  Boolean                  @default(false)
  isStarred Boolean                  @default(false)
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt

  channel  CommunicationChannel?        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  replyTo  CommunicationMessage?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies  CommunicationMessage[]       @relation("MessageReplies")
  reactions CommunicationReaction[]
  threads  CommunicationThread[]
  statuses CommunicationMessageStatus[]
  tasks    CommunicationTask[]

  @@index([tenantId])
  @@index([channelId])
  @@index([dmPairId])
  @@index([senderId])
  @@index([replyToId])
}

model CommunicationReaction {
  id        String   @id @default(uuid())
  tenantId  String
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([tenantId])
  @@index([messageId])
  @@index([userId])
}

model CommunicationThread {
  id              String   @id @default(uuid())
  tenantId        String
  parentMessageId String
  messageId       String
  createdAt       DateTime @default(now())

  parentMessage CommunicationMessage @relation(fields: [parentMessageId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([parentMessageId])
  @@index([messageId])
}

model CommunicationCall {
  id        String                  @id @default(uuid())
  tenantId  String
  commHubId String
  channelId String?
  callerId  String
  type      CommunicationCallType   @default(AUDIO)
  status    CommunicationCallStatus @default(INITIATED)
  startedAt DateTime                @default(now())
  endedAt   DateTime?
  createdAt DateTime                @default(now())

  channel      CommunicationChannel?          @relation(fields: [channelId], references: [id], onDelete: SetNull)
  participants CommunicationCallParticipant[]
  aiSummaries  CommunicationAiSummary[]

  @@index([tenantId])
  @@index([commHubId])
  @@index([channelId])
  @@index([callerId])
}

model CommunicationCallParticipant {
  id       String    @id @default(uuid())
  tenantId String
  callId   String
  userId   String
  status   String    @default("JOINED")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  call CommunicationCall @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@index([tenantId])
  @@index([callId])
  @@index([userId])
}

model CommunicationPresence {
  id           String                      @id @default(uuid())
  tenantId     String
  userId       String                      @unique
  status       CommunicationPresenceStatus @default(ONLINE)
  customStatus String?
  lastSeenAt   DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([tenantId])
  @@index([userId])
}

model CommunicationDevice {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  pushToken String
  platform  String   @default("WEB")
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
}

model CommunicationMessageStatus {
  id        String    @id @default(uuid())
  tenantId  String
  messageId String
  userId    String
  status    String    @default("DELIVERED") // SENT | DELIVERED | READ
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  message CommunicationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([tenantId])
  @@index([messageId])
  @@index([userId])
}

model CommunicationAiSummary {
  id          String   @id @default(uuid())
  tenantId    String
  channelId   String?
  callId      String?
  summary     String   @db.Text
  actionItems String?  @db.Text
  highlights  String?  @db.Text
  createdAt   DateTime @default(now())

  channel CommunicationChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)
  call    CommunicationCall?    @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
}

model CommunicationMeeting {
  id          String    @id @default(uuid())
  tenantId    String
  commHubId   String
  title       String
  description String?
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  status      String    @default("SCHEDULED") // SCHEDULED | ONGOING | COMPLETED | CANCELLED
  meetingLink String?
  interviewId String?   @unique
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  notes     CommunicationNote[]
  commHub   CommunicationHub @relation(fields: [commHubId], references: [id], onDelete: Cascade)
  interview Interview?       @relation(fields: [interviewId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([commHubId])
}

model CommunicationNote {
  id             String   @id @default(uuid())
  tenantId       String
  meetingId      String?
  channelId      String?
  content        String   @db.Text
  version        Int      @default(1)
  lastEditedById String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  meeting CommunicationMeeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  channel CommunicationChannel? @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([meetingId])
  @@index([channelId])
}

model CommunicationTask {
  id          String    @id @default(uuid())
  tenantId    String
  messageId   String?
  title       String
  description String?
  status      String    @default("TODO") // TODO | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  assigneeId  String?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  message CommunicationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([messageId])
  @@index([assigneeId])
}

model CommunicationSettings {
  id                   String   @id @default(uuid())
  tenantId             String
  userId               String   @unique
  notificationSound    Boolean  @default(true)
  desktopNotifications Boolean  @default(true)
  defaultStatus        String   @default("ONLINE")
  theme                String   @default("LIGHT")
  autoJoinMeetings     Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([tenantId])
  @@index([userId])
}

model CandidateTimelineEvent {
  id          String   @id @default(uuid())
  tenantId    String
  candidateId String
  title       String
  description String?
  eventType   String   @default("SYSTEM") // SYSTEM | COMMUNICATION | INTERVIEW | STAGE_CHANGE
  metadata    Json?
  actorId     String?
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([candidateId])
}

model AutomationWorkflow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String // e.g., "CANDIDATE_APPLIED", "INTERVIEW_ENDED"
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules   AutomationRule[]
  actions AutomationAction[]
  logs    AutomationLog[]

  @@index([tenantId, trigger, isActive])
}

model AutomationRule {
  id         String @id @default(uuid())
  workflowId String
  field      String // e.g., "candidate.experienceYears"
  operator   String // e.g., "GREATER_THAN"
  value      String // e.g., "5"

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model AutomationAction {
  id         String @id @default(uuid())
  workflowId String
  type       String // e.g., "SEND_EMAIL", "CREATE_MEETING", "ASSIGN_RECRUITER"
  payload    Json? // Specific configuration for the action
  orderIndex Int    @default(0)

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
}

model AutomationLog {
  id         String   @id @default(uuid())
  tenantId   String
  workflowId String
  entityId   String // The ID of the Candidate or Interview being processed
  status     String // "SUCCESS", "FAILED", "PENDING"
  error      String?
  executedAt DateTime @default(now())

  workflow AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

